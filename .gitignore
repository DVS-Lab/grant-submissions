# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# Root pkgdown site (allow project-level documentation directories)
/docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
.DS_Store

# Private participant-level data
**/PRIVATE*
**/*PRIVATE*
**/*crosswalk*
**/*Crosswalk*
**/*contact*
**/*email_capture*

# Raw survey / panel exports
**/*Qualtrics*
**/*REDCap*
**/rawdata/
**/raw-data/
**/private-data/

# Local participant-level source data
**/sourcedata/*.xlsx
**/sourcedata/*.xls
**/sourcedata/*.csv
**/sourcedata/*.tsv
**/sourcedata/*.rds
**/sourcedata/*.RData

# Explicit local deidentified analytic sources
**/*DEIDENTIFIED*.xlsx
**/*DEIDENTIFIED*.csv

# SDOH participant-level scoring outputs (aggregate CSVs remain allowed)
2025_R03-SDOH/derivatives/*_scoring.csv
2025_R03-SDOH/derivatives/scoring-mastersheet*.csv

# SDOH: participant-level data are prohibited anywhere in this public project
2025_R03-SDOH/**/*.csv
2025_R03-SDOH/**/*.tsv
2025_R03-SDOH/**/*.xlsx
2025_R03-SDOH/**/*.xls
2025_R03-SDOH/**/*.rds
2025_R03-SDOH/**/*.RData
2025_R03-SDOH/**/*.parquet
2025_R03-SDOH/**/*.feather
2025_R03-SDOH/**/*.sav
2025_R03-SDOH/**/*.dta

# Metadata-only dictionary is intentionally public
!2025_R03-SDOH/docs/analytic-variable-dictionary.csv
